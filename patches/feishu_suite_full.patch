+class _FakeGw:
+    def __init__(self):
+        self.overrides = {}
+        self.reasoning = {}
+        self.evicted = []
+        self.async_session_store = _FakeAsyncStore()
+        self.session_store = SimpleNamespace(get_or_create_session=lambda src: None)
