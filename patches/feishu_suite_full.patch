+def test_tool_tee_runs_without_progress_queue(monkeypatch):
+    """飞书 tool_progress=false → needs_progress_queue=False → progress_queue=None。
+
+    回归：原实现把 CardKit 工具 tee 放在 `if not ctx.progress_queue: return` 之后，
