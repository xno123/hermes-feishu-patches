+    assert a is not b and a.open_ok and b.open_ok
+    assert not a.finalized, "后一轮 ensure 把前一轮的卡 finalize 掉了（原单槽 bug）"
+    # 标题来自本轮消息摘要，不查 state.db（自动标题有落库竞态）
+    assert a.title == "检查 hermes 更新" and b.title == "另一个任务"
